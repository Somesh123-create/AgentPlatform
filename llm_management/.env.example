APP_NAME=LLM Management Service
APP_ENV=development
DEBUG=false
POSTGRES_DB=agentplatform
POSTGRES_USER=agentplatformuser
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
JWT_SECRET_KEY=your-strong-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_TOKEN_URL=http://localhost:8000/auth/login
LLM_ENCRYPTION_KEY=replace-with-a-fernet-key
