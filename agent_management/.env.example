APP_NAME=Agent Management Service
APP_ENV=development
DEBUG=true

POSTGRES_DB=agentplatform
POSTGRES_USER=agentplatformuser
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SECRET_KEY=your-strong-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_TOKEN_URL=http://localhost:8000/auth/login
